# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# generated by scripts/generate-seo.mjs
/public/robots.txt
/public/sitemap.xml

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (the example file is committed, real ones are not)
.env*
!.env.example

# vercel
.vercel

# editors and local tooling
.idea/
.vscode/
.claude/
Thumbs.db

# typescript
*.tsbuildinfo
next-env.d.ts
